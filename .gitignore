
/*

!/.gitignore
!/.env.example
!/README.md
!/APPROACH.md
!/pyproject.toml
!/requirements-gpu.txt
!/requirements-mac.txt

!/configs/
/configs/*
!/configs/marathi.json

# Share executable source only, not generated files or caches.
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh

!/src/
/src/*
!/src/marathi_asr/
/src/marathi_asr/*
!/src/marathi_asr/*.py

!/tests/
/tests/*
!/tests/test_*.py

# Credentials must stay private even inside an allowed source folder.
.env
.env.*
!/.env.example
*.pem
*.key
credentials*
secrets*
